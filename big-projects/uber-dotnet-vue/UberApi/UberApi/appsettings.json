{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
  "ConnectionStrings": {
    "S221UberContext": "Server=your-server.postgres.database.azure.com;port=5432;Database=your-database; uid=your-username; password=YOUR_PASSWORD_HERE;"
  },
    "Jwt": {
        // La clé doit au moins contenir 16 caractères
        // ATTENTION: Utilisez User Secrets pour le développement local
        // Pour configurer: dotnet user-secrets set "Jwt:SecretKey" "votre-cle-secrete"
        // Pour la production, utilisez des variables d'environnement ou Azure Key Vault
        "SecretKey": "YOUR_JWT_SECRET_KEY_HERE_MIN_16_CHARS",
        "Issuer": "https://localhost:7076/",
        "Audience": "https://localhost:7076/"
    }
}
